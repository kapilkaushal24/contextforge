AITO_ENVIRONMENT=development
AITO_CORS_ALLOW_ORIGINS=["chrome-extension://<your-dev-extension-id>"]
AITO_REQUIRE_API_KEY=false
AITO_API_KEY=
AITO_SEMANTIC_CONFIDENCE_THRESHOLD=0.85
AITO_COST_OPTIMIZATION_ENABLED=true
AITO_INPUT_PRICE_PER_1K_USD=0.003
# LLM (semantic) optimization -- off by default. Requires a key; never commit real keys.
AITO_ENABLE_LLM_OPTIMIZATION=false
AITO_LLM_PROVIDER=openai
AITO_LLM_MODEL=gpt-4o-mini
AITO_LLM_API_KEY=
AITO_LLM_INPUT_PRICE_PER_1K_USD=0.00015
AITO_LLM_OUTPUT_PRICE_PER_1K_USD=0.0006
AITO_BLOCK_PII_FROM_CLOUD=true
AITO_PLATFORM_TOKENIZER_MAP={"chatgpt":"openai","claude":"anthropic","gemini":"gemini"}
